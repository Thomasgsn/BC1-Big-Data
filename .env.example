# Paramètres BC1. Préférer scripts/bootstrap.py : images épinglées et secrets générés.
# Renseigner les secrets dans .env non versionné ou via des fichiers dédiés.
COMPOSE_FILE=docker-compose.yml:infra/hadoop-modern/migration.yml
PAYSIM_CSV_PATH=data/raw/PS_20174392719_1491204439457_log.csv
DATASET_VERSION=2
DATASET_SHA256=16910f90577b0d981bf8ff289714510bb89bc71bff7d3f220f024e287e4eea6b
REPLAY_RATE_PER_SECOND=100
REPLAY_EPOCH_UTC=
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
MONGO_PASSWORD=
MONGO_APP_PASSWORD=
API_TOKEN_ANALYST=
API_TOKEN_READER=
